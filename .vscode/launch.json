{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Nanobind Extension",
            "type": "lldb",
            "request": "launch",
            // 1. Explicitly point to the virtual environment's Python
            "program": "${workspaceFolder}/.venv/bin/python", 
            // If on Linux/macOS, use: "${workspaceFolder}/.venv/bin/python"
            
            // 2. Pass your Python test script as an argument
            "args": [
                "${workspaceFolder}/python/fafrl/main.py"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            
            // 3. Force environmental consistency if needed
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            
            // 4. (Optional) Helpful for locating source files on complex layouts
            "sourceMap": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        }
    ]
}